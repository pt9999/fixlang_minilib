module Main;

main: IO () = (
    let f: I64 -> IO (Array I64) = |n| (
        // 関数内部の定数配列がユニークにならない？
        let arr = [1, 2, 3];        // "Array storage is not unique: not unique"
        //let arr = [1, 2, 3, n];   // 定数配列でなければ問題なし
        let arr = arr.assert_unique_array(|_| "not unique");
        pure $ arr
    );
    let arr = *f(10);
    println $ arr.to_string
);