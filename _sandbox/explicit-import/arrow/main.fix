/*
    以下の条件で fix edit explicit-import を実行しても Std::Arrow が import されない。
    その状態で fix run を実行すると "error: Unknown type or associated type name `Arrow`." というエラーになる。

    - モジュール内で Arrow が使用されている
*/
module Main;

test_arrow: Arrow () String -> String;
test_arrow = |f| f();

main: IO () = (
    test_arrow(|_| "Hello world!").println
);
