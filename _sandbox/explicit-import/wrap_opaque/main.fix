/*
    以下の条件で fix edit explicit-import を実行すると、import に #wrap_opaque という
    名前が追加される。その状態で fix run を実行すると "error: Expected import_item_any."
    というエラーになる。

    - Subモジュールに戻り値がopaque型のメソッドを持つtraitが定義されている。
    - MainモジュールからSubモジュールをimportし、そのtraitをimplする。
*/
module Main;

import Sub;

type Obj = struct {};

impl Obj: Greeting {
    greeting = |obj| "Hello World!";
}

main: IO () = (
    Obj{}.greeting.to_string.println
);
